# ─────────────────────────────────────────────────────────────────────────────
# TWINEX Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.

# MongoDB Atlas connection string
# Get this from your MongoDB Atlas dashboard → Clusters → Connect →
# "Connect your application" → choose "Node.js (driver)" and copy the URI.
# Replace <password> and <cluster-name> as needed.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/twinex?retryWrites=true&w=majority

# Clerk backend secret key (from the Clerk dashboard → API keys → Secret key)
# ⚠️ NEVER commit this to source control.
CLERK_SECRET_KEY=sk_test_PLACEHOLDER_REPLACE_ME

# Clerk JWT public key (PEM format) for networkless token verification
# From Clerk dashboard → API keys → Show JWT public key → PEM Public Key
CLERK_JWT_KEY=PLACEHOLDER_REPLACE_ME

# Port for the Express server
PORT=3000

# Node environment
NODE_ENV=development